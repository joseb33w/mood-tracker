# Copy this file to .env and fill in real values.
# Both variables are exposed to the browser (Vite "VITE_" prefix is intentional).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the table name if you're hosting your own Supabase project.
# Defaults to the Gogi-managed table name.
# VITE_MOODS_TABLE=your_moods_table
